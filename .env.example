# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MCP auth (рекомендуется на проде)
MCP_SECRET=

# Публичный URL деплоя (на Vercel подставится из VERCEL_URL)
# PUBLIC_URL=https://telegram-mcp.vercel.app

# --- опционально: мост Telegram → Cursor Cloud Agent ---
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_CHAT_IDS=123456789
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# CURSOR_WORKSPACE_NAME=grill   # заголовок агента в Cursor (не cloud env!)
# CURSOR_AGENT_ID=bc-...   # опционально, если несколько агентов с одним именем
# CURSOR_REPO_URL=https://github.com/you/grill   # только агент grill (код), не секретарь
# CURSOR_REPO_REF=main

# Секретарь: kb.ts и/или приватный GitHub с markdown (Obsidian Git):
# SECRETARY_KB_GITHUB=you/grill-kb
# SECRETARY_KB_GITHUB_PATH=  # папка внутри репо, пусто = все .md
# SECRETARY_KB_GITHUB_REF=main
# GITHUB_TOKEN=github_pat_...  # fine-grained, Contents: Read, только этот репо
# SECRETARY_KB_URLS=https://...  # только публичные URL, не для секретов

# Whisper для голосовых (опционально):
# OPENAI_API_KEY=sk-...
